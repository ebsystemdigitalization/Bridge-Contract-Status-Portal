FROM node:22-slim AS build

WORKDIR /app

COPY package*.json ./

RUN npm ci

COPY . .

# =========================================================
# Firebase
# =========================================================

ARG VITE_FIREBASE_API_KEY
ARG VITE_FIREBASE_AUTH_DOMAIN
ARG VITE_FIREBASE_PROJECT_ID
ARG VITE_FIREBASE_APP_ID
ARG VITE_FIREBASE_STORAGE_BUCKET
ARG VITE_FIREBASE_MESSAGING_SENDER_ID

ENV VITE_FIREBASE_API_KEY=$VITE_FIREBASE_API_KEY
ENV VITE_FIREBASE_AUTH_DOMAIN=$VITE_FIREBASE_AUTH_DOMAIN
ENV VITE_FIREBASE_PROJECT_ID=$VITE_FIREBASE_PROJECT_ID
ENV VITE_FIREBASE_APP_ID=$VITE_FIREBASE_APP_ID
ENV VITE_FIREBASE_STORAGE_BUCKET=$VITE_FIREBASE_STORAGE_BUCKET
ENV VITE_FIREBASE_MESSAGING_SENDER_ID=$VITE_FIREBASE_MESSAGING_SENDER_ID

# =========================================================
# Backend API
# =========================================================

ARG VITE_API_BASE_URL

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

# =========================================================
# DMS / Dealer - Azure AD B2C
# =========================================================

ARG VITE_ADB2C_CLIENT_ID
ARG VITE_ADB2C_TENANT_ID
ARG VITE_ADB2C_POLICY
ARG VITE_ADB2C_REDIRECT_URI

ENV VITE_ADB2C_CLIENT_ID=$VITE_ADB2C_CLIENT_ID
ENV VITE_ADB2C_TENANT_ID=$VITE_ADB2C_TENANT_ID
ENV VITE_ADB2C_POLICY=$VITE_ADB2C_POLICY
ENV VITE_ADB2C_REDIRECT_URI=$VITE_ADB2C_REDIRECT_URI

# =========================================================
# Internal Employees - Microsoft Entra ID
# =========================================================

ARG VITE_EMPLOYEE_ENTRA_CLIENT_ID
ARG VITE_EMPLOYEE_ENTRA_TENANT_ID
ARG VITE_EMPLOYEE_ENTRA_REDIRECT_URI

ENV VITE_EMPLOYEE_ENTRA_CLIENT_ID=$VITE_EMPLOYEE_ENTRA_CLIENT_ID
ENV VITE_EMPLOYEE_ENTRA_TENANT_ID=$VITE_EMPLOYEE_ENTRA_TENANT_ID
ENV VITE_EMPLOYEE_ENTRA_REDIRECT_URI=$VITE_EMPLOYEE_ENTRA_REDIRECT_URI

# =========================================================
# Build
# =========================================================

RUN npm run build


# =========================================================
# NGINX
# =========================================================

FROM nginx:1.27-alpine

COPY --from=build /app/dist /usr/share/nginx/html

COPY nginx.conf /etc/nginx/conf.d/default.conf