    {"id":"T05.E","title":"Admin route authorization bypass","description":"Role checks prevent authenticated users from reaching admin functions.","stride_category":"E","tier":2,"prerequisites":"Authenticated User","status":"Mitigated","mitigation":"requireAdmin and requireSuperAdmin enforce roles.","identity_key":{"component_id":"AuthMiddleware","data_flow_id":"DF_ExpressApi_to_AuthMiddleware","stride_category":"E","attack_surface":"backend/src/middleware/auth.ts:requireAdmin"}},
