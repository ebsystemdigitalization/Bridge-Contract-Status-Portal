    {"id":"T01.A","title":"Browser search history exposure","description":"Recent search values in localStorage can reveal sensitive lookup history.","stride_category":"A","tier":3,"prerequisites":"Host/OS Access","status":"Open","mitigation":"Store recent searches in memory or clear them on logout.","identity_key":{"component_id":"BrowserClient","data_flow_id":"DF_AdminUser_to_BrowserClient","stride_category":"A","attack_surface":"src/pages/SearchPage.tsx:localStorage"}},
    {"id":"T01.I","title":"PKCE verifier localStorage exposure","description":"PKCE verifier and state are stored in localStorage during login.","stride_category":"I","tier":3,"prerequisites":"Host/OS Access","status":"Open","mitigation":"Use sessionStorage or in-memory storage and deploy CSP.","identity_key":{"component_id":"BrowserClient","data_flow_id":"DF_BrowserClient_to_AzureADB2C","stride_category":"I","attack_surface":"src/context/AuthContext.tsx:localStorage"}},
    {"id":"T02.D","title":"Proxy limit gaps","description":"nginx proxy lacks visible request body and timeout limits for API traffic.","stride_category":"D","tier":1,"prerequisites":"None","status":"Open","mitigation":"Add proxy request size and timeout limits.","identity_key":{"component_id":"NginxFrontend","data_flow_id":"DF_NginxFrontend_to_ExpressApi","stride_category":"D","attack_surface":"nginx.conf:/api proxy"}},
    {"id":"T02.I","title":"Missing CSP","description":"Frontend responses do not configure Content-Security-Policy.","stride_category":"I","tier":1,"prerequisites":"None","status":"Open","mitigation":"Add strict CSP headers.","identity_key":{"component_id":"NginxFrontend","data_flow_id":"DF_BrowserClient_to_NginxFrontend","stride_category":"I","attack_surface":"nginx.conf:headers"}},
    {"id":"T03.D","title":"Broad JSON parser limit","description":"Express applies a 25 MB JSON limit globally.","stride_category":"D","tier":1,"prerequisites":"None","status":"Open","mitigation":"Use smaller global limits and route-specific parsers.","identity_key":{"component_id":"ExpressApi","data_flow_id":"DF_NginxFrontend_to_ExpressApi","stride_category":"D","attack_surface":"backend/src/server.ts:express.json"}},
    {"id":"T03.I","title":"Verbose error responses","description":"The global error handler returns internal error messages to clients.","stride_category":"I","tier":1,"prerequisites":"None","status":"Open","mitigation":"Return generic errors and log details server-side.","identity_key":{"component_id":"ExpressApi","data_flow_id":"DF_NginxFrontend_to_ExpressApi","stride_category":"I","attack_surface":"backend/src/server.ts:error handler"}},
    {"id":"T04.D","title":"Public auth route throttling gap","description":"Public auth helper endpoints do not use repository rate limiting.","stride_category":"D","tier":1,"prerequisites":"None","status":"Open","mitigation":"Add rate limiting and backoff to auth routes.","identity_key":{"component_id":"AuthRouter","data_flow_id":"DF_ExpressApi_to_AuthRouter","stride_category":"D","attack_surface":"backend/src/routes/auth.ts"}},
    {"id":"T04.I","title":"Login resolution enumeration","description":"The resolve-login endpoint reveals stored email versus fallback email behavior.","stride_category":"I","tier":1,"prerequisites":"None","status":"Open","mitigation":"Return indistinguishable responses and throttle probes.","identity_key":{"component_id":"AuthRouter","data_flow_id":"DF_ExpressApi_to_AuthRouter","stride_category":"I","attack_surface":"backend/src/routes/auth.ts:/resolve-login"}},
